<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>webcam_cam_camera_10859.ico</ApplicationIcon>
    <AssemblyName>D2RCameraTool</AssemblyName>
    <RootNamespace>D2RCameraTool</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Ship the files the tool needs at runtime. settings.ini was previously absent from
       the publish output, so a fresh copy could not start; note that a plain
       <None Remove="..."/> would cancel the Update below and silently drop the .CT too. -->
  <ItemGroup>
    <None Update="settings.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="D2RCamera.CT">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Memory.dll is intentionally gone: it was a prebuilt binary (unpatchable, and a
       documented source of antivirus false positives). Win32Memory.cs now provides
       OpenProcess / ReadProcessMemory / WriteProcessMemory / VirtualQueryEx directly. -->

</Project>
