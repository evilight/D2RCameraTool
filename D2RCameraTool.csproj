<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>webcam_cam_camera_10859.ico</ApplicationIcon>
    <AssemblyName>D2RCameraTool</AssemblyName>
    <RootNamespace>D2RCameraTool</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="D2R.1.6.77312.exe" />
    <None Remove="D2RCamera.CT" />
  </ItemGroup>

  <!-- Memory.dll is intentionally gone: it was a prebuilt binary (unpatchable, and a
       documented source of antivirus false positives). Win32Memory.cs now provides
       OpenProcess / ReadProcessMemory / WriteProcessMemory / VirtualQueryEx directly. -->

</Project>
